{
  "extends": "@total-typescript/tsconfig/tsc/no-dom/app",
  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules"],
  "compilerOptions": {
    "baseUrl": "./src",
    "paths": {
      "@/routes/*": ["routes/*"],
      "@/controllers/*": ["controllers/*"],
      "@/services/*": ["services/*"],
      "@/models/*": ["models/*"],
      "@/middleware/*": ["middleware/*"],
      "@/types/*": ["types/*"],
      "@/utils/*": ["utils/*"],
      "@/config/*": ["config/*"],
      "@/*": ["*"]
    },
    "rootDir": "src",
    "outDir": "dist"
  }
}
