{
  "name": "back-end-exercise",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && tsc-alias",
    "build:css": "tailwindcss -i public/stylesheets/tailwind.css -o ./public/stylesheets/styles.css --minify",
    "dev": "dotenvx run -- tsx watch src/index.ts",
    "dev:css": "tailwindcss -i public/stylesheets/tailwind.css -o ./public/stylesheets/styles.css --watch",
    "format": "prettier --write .",
    "lint": "eslint .",
    "start": "dotenvx run -- nodemon dist/index.js",
    "test": "vitest --ui"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "^1.51.0",
    "@supabase/supabase-js": "^2.75.0",
    "cookie-parser": "~1.4.4",
    "debug": "~2.6.9",
    "dotenv": "^17.2.3",
    "express": "~4.16.1",
    "express-validator": "^7.2.1",
    "morgan": "~1.9.1"
  },
  "devDependencies": {
    "@eslint/compat": "^1.4.0",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.37.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "@jest/globals": "^30.2.0",
    "@stylistic/eslint-plugin": "^3.1.0",
    "@tailwindcss/cli": "^4.1.14",
    "@total-typescript/tsconfig": "^1.0.4",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.8.1",
    "@vitest/ui": "^3.2.4",
    "eslint": "^9.37.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-airbnb-extended": "^2.3.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-jsdoc": "^61.1.4",
    "eslint-plugin-n": "^17.23.1",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.4.0",
    "nodemon": "^3.1.10",
    "prettier": "3.6.2",
    "prettier-plugin-jsdoc": "^1.3.3",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "supertest": "^7.1.4",
    "tailwindcss": "^4.1.14",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@tailwindcss/oxide",
      "unrs-resolver"
    ]
  }
}
