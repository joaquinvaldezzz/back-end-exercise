{
  "printWidth": 100,
  "singleQuote": true,
  "plugins": [
    "@ianvs/prettier-plugin-sort-imports",
    "prettier-plugin-jsdoc",
    "prettier-plugin-tailwindcss"
  ],
  "importOrder": [
    "<BUILTIN_MODULES>",
    "",
    "<THIRD_PARTY_MODULES>",
    "",
    "^@/routes/(.*)$",
    "^@/controllers/(.*)$",
    "^@/services/(.*)$",
    "^@/models/(.*)$",
    "^@/utils/(.*)$",
    "^@/config/(.*)$",
    "",
    "<TYPES>^(node:)",
    "<TYPES>",
    "^@/types/(.*)$",
    "<TYPES>^[.]",
    "",
    "^[./]"
  ],
  "tailwindStylesheet": "./src/styles/main.css"
}
